# ML-DSA Library Windows Makefile (NMAKE)
# Builds libmldsa.lib - C-compatible wrapper for the C++20 ML-DSA library
#
# Usage: nmake /f Makefile.win
#
# Prerequisites: Visual Studio with C++20 support (VS 2019 16.10+ or VS 2022)

# Compiler and library tool
CXX = cl
LIB = lib

# C++20 required for ML-DSA
CXXFLAGS = /std:c++20 /O2 /W3 /EHsc /MD /DWIN32 /D_WINDOWS

# ML-DSA header paths (relative to wrapper/ml-dsa-lib/)
ML_DSA_INCLUDE = ..\..\ml-dsa\include
SHA3_INCLUDE = ..\..\ml-dsa\sha3\include
RANDOMSHAKE_INCLUDE = ..\..\ml-dsa\RandomShake\include

INCLUDES = /I$(ML_DSA_INCLUDE) /I$(SHA3_INCLUDE) /I$(RANDOMSHAKE_INCLUDE) /I.

# Output library
TARGET = libmldsa.lib

# Source and object files
SOURCES = ml_dsa_api.cpp
OBJECTS = ml_dsa_api.obj

all: $(TARGET)

$(TARGET): $(OBJECTS)
	$(LIB) /OUT:$(TARGET) $(OBJECTS)

ml_dsa_api.obj: ml_dsa_api.cpp ml_dsa_api.h
	$(CXX) $(CXXFLAGS) $(INCLUDES) /c ml_dsa_api.cpp /Fo$@

clean:
	-del /Q *.obj *.lib 2>nul
