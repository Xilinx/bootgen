   85                 | PARENT_UNIQUE_ID EQUAL expression
   86                 | FUNCTION_ID EQUAL expression
   87                 | PCR_NUMBER EQUAL expression
   88                 | PCR_MEASUREMENT_INDEX EQUAL expression

   89 partition_spec: PARTITION partition_content
   90               | partition_content

   91 partition_content: /* empty */
   92                  | partition_content file_spec
   93                  | partition_content new_file_spec

   94 other_spec: OBRACKET KEYSRC_ENCRYPTION EBRACKET key_src

   95 $@4: /* empty */

   96 other_spec: OBRACKET FSBL_CONFIG $@4 EBRACKET fsbl_attr_list
   97           | FSBL_CONFIG OBRACE fsbl_attr_list EBRACE
   98           | BOOT_DEVICE OBRACE sec_boot_attr_list EBRACE
   99           | OBRACKET BOOT_DEVICE EBRACKET boot_device_type
  100           | BOOT_DEVICE EQUAL boot_device_type
