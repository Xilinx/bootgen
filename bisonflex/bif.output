   36             | SK_FILE1 EQUAL filename
   37             | SPK_SIGNATURE_FILE EQUAL filename
   38             | PRESIGN EQUAL filename
   39             | REVOKE_ID EQUAL expression
   40             | SPK_REVOKE_ID EQUAL expression
   41             | CHECKSUM EQUAL checkvalue
   42             | DPA_CM
   43             | BLOCKS EQUAL metahdr_blk
   44             | PUFHD_LOC

   45 optional_data: optional_data_attr
   46              | optional_data_attr SEMICOLON optional_data

   47 optional_data_attr: filename COMMA ID EQUAL expression
   48                   | /* empty */

   49 metahdr_blk: metahdr_blk_attr
   50            | metahdr_blk_attr SEMICOLON metahdr_blk

   51 metahdr_blk_attr: expression
   52                 | expression LPAREN expression RPAREN
   53                 | expression LPAREN ASTERISK RPAREN

   54 new_pdi_spec: ID EQUAL expression
   55             | PARENT_ID EQUAL expression
   56             | ID_CODE EQUAL expression
   57             | EXT_ID_CODE EQUAL expression
   58             | PK_FILE EQUAL filename
   59             | SK_FILE EQUAL filename
   60             | PK_FILE1 EQUAL filename
   61             | SK_FILE1 EQUAL filename
   62             | other_file_attr EQUAL filename
   63             | KEYSRC_ENCRYPTION EQUAL key_src
   64             | PARTITION_TYPE EQUAL ptypevalue
   65             | REVOKE_ID EQUAL expression

   66 image_spec: image_list
   67           | image_spec image_list

   68 $@3: /* empty */

   69 image_list: IMAGE OBRACE $@3 image_content EBRACE

   70 image_content: /* empty */
   71              | image_content image_attributes_list
   72              | image_content file_spec
   73              | image_content partition_spec

   74 image_attributes_list: image_attributes
   75                      | image_attributes COMMA image_attributes_list
   76                      | image_attributes image_attributes_list

   77 image_attributes: ID EQUAL expression
   78                 | NAME EQUAL WORD
   79                 | DELAY_HANDOFF
   80                 | DELAY_LOAD
   81                 | INIT
   82                 | COPY EQUAL expression
   83                 | PARTITION_TYPE EQUAL ptypevalue
