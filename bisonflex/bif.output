Grammar

    0 $accept: bif $end

    1 bif: group_list

    2 group_list: /* empty */
    3           | group_list bifoptions

    4 bifoptions: INCLUDE COLON filename

    5 $@1: /* empty */

    6 bifoptions: WORD $@1 COLON OBRACE file_list EBRACE

    7 file_list: /* empty */
    8          | file_list file_spec
    9          | file_list other_spec
   10          | file_list image_spec
   11          | file_list metahdr_spec
   12          | file_list new_pdi_spec
   13          | file_list new_file_spec
   14          | file_list partition_spec

   15 $@2: /* empty */

   16 metahdr_spec: METAHEADER OBRACE $@2 metahdr_attr_list EBRACE

   17 metahdr_attr_list: metahdr_attr
   18                  | metahdr_attr COMMA metahdr_attr_list
   19                  | metahdr_attr metahdr_attr_list

   20 metahdr_attr: /* empty */
   21             | ENCRYPTION EQUAL encrvalue
   22             | KEYSRC_ENCRYPTION EQUAL key_src
   23             | AES_KEY_FILE EQUAL filename
   24             | AUTHENTICATION EQUAL authvalue
   25             | PPK_FILE EQUAL filename
   26             | PSK_FILE EQUAL filename
