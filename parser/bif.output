Grammar

    0 $accept: bif $end

    1 bif: group_list

    2 group_list: /* empty */
    3           | group_list bifoptions

    4 bifoptions: INCLUDE COLON filename

    5 $@1: /* empty */

    6 bifoptions: WORD $@1 COLON OBRACE file_list EBRACE

    7 file_list: /* empty */
    8          | file_list file_spec
    9          | file_list other_spec
   10          | file_list image_spec
   11          | file_list metahdr_spec
   12          | file_list new_pdi_spec
   13          | file_list new_file_spec
   14          | file_list partition_spec

   15 $@2: /* empty */

   16 metahdr_spec: METAHEADER OBRACE $@2 metahdr_attr_list EBRACE

   17 metahdr_attr_list: metahdr_attr
   18                  | metahdr_attr COMMA metahdr_attr_list
   19                  | metahdr_attr metahdr_attr_list

   20 metahdr_attr: /* empty */
   21             | ENCRYPTION EQUAL encrvalue
   22             | KEYSRC_ENCRYPTION EQUAL key_src
   23             | AES_KEY_FILE EQUAL filename
   24             | AUTHENTICATION EQUAL authvalue
   25             | PPK_FILE EQUAL filename
   26             | PSK_FILE EQUAL filename
   27             | SPK_FILE EQUAL filename
   28             | SSK_FILE EQUAL filename
   29             | SPK_SIGNATURE_FILE EQUAL filename
   30             | PRESIGN EQUAL filename
   31             | REVOKE_ID EQUAL expression
   32             | SPK_REVOKE_ID EQUAL expression
   33             | CHECKSUM EQUAL checkvalue
   34             | DPA_CM
   35             | BLOCKS EQUAL metahdr_blk
   36             | PUFHD_LOC

   37 optional_data: optional_data_attr
   38              | optional_data_attr SEMICOLON optional_data

   39 optional_data_attr: filename COMMA ID EQUAL expression
   40                   | /* empty */

   41 metahdr_blk: metahdr_blk_attr
   42            | metahdr_blk_attr SEMICOLON metahdr_blk

   43 metahdr_blk_attr: expression
   44                 | expression LPAREN expression RPAREN
   45                 | expression LPAREN ASTERISK RPAREN

   46 new_pdi_spec: ID EQUAL expression
   47             | PARENT_ID EQUAL expression
   48             | ID_CODE EQUAL expression
   49             | EXT_ID_CODE EQUAL expression
   50             | other_file_attr EQUAL filename
   51             | KEYSRC_ENCRYPTION EQUAL key_src
   52             | PARTITION_TYPE EQUAL ptypevalue
   53             | REVOKE_ID EQUAL expression

   54 image_spec: image_list
   55           | image_spec image_list

   56 $@3: /* empty */

   57 image_list: IMAGE OBRACE $@3 image_content EBRACE

   58 image_content: /* empty */
   59              | image_content image_attributes_list
   60              | image_content file_spec
   61              | image_content partition_spec

   62 image_attributes_list: image_attributes
   63                      | image_attributes COMMA image_attributes_list
   64                      | image_attributes image_attributes_list

   65 image_attributes: ID EQUAL expression
   66                 | NAME EQUAL WORD
   67                 | DELAY_HANDOFF
   68                 | DELAY_LOAD
   69                 | INIT
   70                 | COPY EQUAL expression
   71                 | PARTITION_TYPE EQUAL ptypevalue
   72                 | UNIQUE_ID EQUAL expression
   73                 | PARENT_UNIQUE_ID EQUAL expression
   74                 | FUNCTION_ID EQUAL expression
   75                 | PCR_NUMBER EQUAL expression
   76                 | PCR_MEASUREMENT_INDEX EQUAL expression

   77 partition_spec: PARTITION partition_content
   78               | partition_content

   79 partition_content: /* empty */
   80                  | partition_content file_spec
   81                  | partition_content new_file_spec

   82 other_spec: OBRACKET KEYSRC_ENCRYPTION EBRACKET key_src

   83 $@4: /* empty */

   84 other_spec: OBRACKET FSBL_CONFIG $@4 EBRACKET fsbl_attr_list
   85           | FSBL_CONFIG OBRACE fsbl_attr_list EBRACE
   86           | BOOT_DEVICE OBRACE sec_boot_attr_list EBRACE
